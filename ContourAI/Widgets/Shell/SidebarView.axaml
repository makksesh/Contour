<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ContourAI.Features.Shell"
             xmlns:chat="clr-namespace:ContourAI.Features.Chat"
             xmlns:projects="clr-namespace:ContourAI.Features.Projects"
             x:DataType="shell:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Widgets.Shell.SidebarView">

  <UserControl.Styles>

    <!-- Заголовок секции -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize"      Value="10"/>
      <Setter Property="FontWeight"    Value="SemiBold"/>
      <Setter Property="Foreground"    Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Кнопка «+» добавить чат/проект -->
    <Style Selector="Button.add-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width"       Value="20"/>
      <Setter Property="Height"      Value="20"/>
      <Setter Property="Padding"     Value="0"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize"    Value="16"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment"   Value="Center"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.add-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>

    <!-- Кнопка редактирования «✎» -->
    <Style Selector="Button.edit-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width"       Value="18"/>
      <Setter Property="Height"      Value="18"/>
      <Setter Property="Padding"     Value="0"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="FontSize"    Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment"   Value="Center"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.edit-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>
    <!-- edit-btn активен когда IsEditing=true -->
    <Style Selector="Button.edit-btn.editing /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>

    <!-- Строка элемента (чат / проект) -->
    <Style Selector="Button.item">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="{StaticResource ThemeTextSecondaryBrush}"/>
      <Setter Property="BorderBrush"                Value="Transparent"/>
      <Setter Property="BorderThickness"            Value="1"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding"                    Value="10 6"/>
      <Setter Property="CornerRadius"               Value="10"/>
      <Setter Property="Margin"                     Value="6 2"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.item.active">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>

    <!-- Inline TextBox редактирования -->
    <Style Selector="TextBox.inline-edit">
      <Setter Property="Background"   Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="BorderBrush"  Value="{StaticResource ThemeAccentMutedBrush}"/>
      <Setter Property="BorderThickness" Value="0 0 0 1"/>
      <Setter Property="FontSize"     Value="12"/>
      <Setter Property="Padding"      Value="2 1"/>
      <Setter Property="Height"       Value="22"/>
      <Setter Property="CornerRadius" Value="0"/>
      <Setter Property="CaretBrush"   Value="{StaticResource ThemeAccentBrush}"/>
    </Style>
    <Style Selector="TextBox.inline-edit:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>

    <!-- Кнопка Настройки -->
    <Style Selector="Button.settings">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="{StaticResource ThemeTextSecondaryBrush}"/>
      <Setter Property="BorderBrush"                Value="Transparent"/>
      <Setter Property="BorderThickness"            Value="1"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height"                     Value="44"/>
      <Setter Property="Padding"                    Value="14 0"/>
      <Setter Property="CornerRadius"               Value="12"/>
      <Setter Property="Margin"                     Value="6 4"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.settings:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.settings.active">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.settings:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextMutedBrush}"/>
    </Style>

    <!-- Divider -->
    <Style Selector="Border.divider">
      <Setter Property="Height"     Value="1"/>
      <Setter Property="Background" Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="Margin"     Value="0"/>
    </Style>

  </UserControl.Styles>

  <!-- Основной контейнер -->
  <Border Classes="panel"
          Background="{StaticResource ThemeShellBrush}"
          CornerRadius="24">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="45*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="45*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10*"/>
      </Grid.RowDefinitions>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 1 — Недавние глобальные чаты (45%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="0" RowDefinitions="Auto,*">

        <!-- Заголовок: RECENT CHATS + кнопка + -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="12 14 10 6">
          <TextBlock Grid.Column="0"
                     Classes="section-header"
                     Text="НЕДАВНИЕ ЧАТЫ"/>
          <!-- Кнопка добавить новый чат -->
          <Button Grid.Column="1"
                  Classes="add-btn"
                  Command="{Binding AddNewGlobalChatCommand}"
                  ToolTip.Tip="Новый чат">
            <TextBlock Text="+" FontSize="16" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>

        <!-- Скроллируемый список чатов -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentGlobalChats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chat:ChatThreadItemViewModel">
                <!--
                  Строка чата: кнопка-кликалка (заглушка) + кнопка редактирования.
                  Когда IsEditing=false — показываем TextBlock + TimeLabel.
                  Когда IsEditing=true  — показываем TextBox + Enter для применения.
                -->
                <Grid ColumnDefinitions="*,Auto" Margin="6 1">

                  <!-- Область клика на чат (заглушка) -->
                  <Button Grid.Column="0"
                          Classes="item"
                          Classes.active="{Binding IsSelected}"
                          Command="{Binding $parent[UserControl].((shell:AuthenticatedShellViewModel)DataContext).SelectGlobalChatCommand}"
                          CommandParameter="{Binding}"
                          PointerPressed="GlobalChatItem_PointerPressed"
                          Padding="10 6">
                    <Grid ColumnDefinitions="*,Auto">

                      <!-- Название (или TextBox при редактировании) -->
                      <TextBlock Grid.Column="0"
                                 IsVisible="{Binding !IsEditing}"
                                 Text="{Binding Title}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding $parent[Button].Foreground}"/>
                      <TextBox Grid.Column="0"
                               IsVisible="{Binding IsEditing}"
                               Classes="inline-edit"
                               Text="{Binding EditTitle, Mode=TwoWay}"
                               VerticalAlignment="Center"/>

                      <!-- Время -->
                      <TextBlock Grid.Column="1"
                                 IsVisible="{Binding !IsEditing}"
                                 Text="{Binding TimeLabel}"
                                 FontSize="10"
                                 Foreground="{StaticResource ThemeTextMutedBrush}"
                                 VerticalAlignment="Center"
                                 Margin="6 0 0 0"/>
                    </Grid>
                  </Button>

                  <!-- Кнопка редактирования ✎ -->
                  <Button Grid.Column="1"
                          Classes="edit-btn"
                          Classes.editing="{Binding IsEditing}"
                          Command="{Binding ToggleEditCommand}"
                          VerticalAlignment="Center"
                          Margin="2 0 2 0"
                          ToolTip.Tip="Переименовать">
                    <TextBlock Text="✎" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Button>

                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <!-- Разделитель -->
      <Border Grid.Row="1" Classes="divider"/>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 2 — Недавние проекты (45%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">

        <!-- Заголовок: RECENT PROJECTS + кнопка + -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="12 12 10 6">
          <TextBlock Grid.Column="0"
                     Classes="section-header"
                     Text="НЕДАВНИЕ ПРОЕКТЫ"/>
          <!-- Кнопка добавить новый проект -->
          <Button Grid.Column="1"
                  Classes="add-btn"
                  Command="{Binding AddNewProjectCommand}"
                  ToolTip.Tip="Новый проект">
            <TextBlock Text="+" FontSize="16" FontWeight="Light" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Button>
        </Grid>

        <!-- Скроллируемый список проектов -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="projects:ProjectCardViewModel">
                <!--
                  Строка проекта: кнопка-кликалка (заглушка) + кнопка редактирования.
                -->
                <Grid ColumnDefinitions="*,Auto" Margin="6 1">

                  <!-- Область клика на проект (заглушка) -->
                  <Button Grid.Column="0"
                          Classes="item"
                          Command="{Binding $parent[UserControl].((shell:AuthenticatedShellViewModel)DataContext).OpenProjectFromSidebarCommand}"
                          CommandParameter="{Binding}"
                          Padding="10 6">
                    <Grid ColumnDefinitions="*,Auto">

                      <!-- Название (или TextBox при редактировании) -->
                      <TextBlock Grid.Column="0"
                                 IsVisible="{Binding !IsEditing}"
                                 Text="{Binding Name}"
                                 FontSize="12"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding $parent[Button].Foreground}"/>
                      <TextBox Grid.Column="0"
                               IsVisible="{Binding IsEditing}"
                               Classes="inline-edit"
                               Text="{Binding EditName, Mode=TwoWay}"
                               VerticalAlignment="Center"/>

                      <!-- Дата -->
                      <TextBlock Grid.Column="1"
                                 IsVisible="{Binding !IsEditing}"
                                 Text="{Binding CreatedAtLabel}"
                                 FontSize="10"
                                 Foreground="{StaticResource ThemeTextMutedBrush}"
                                 VerticalAlignment="Center"
                                 Margin="6 0 0 0"/>
                    </Grid>
                  </Button>

                  <!-- Кнопка редактирования ✎ -->
                  <Button Grid.Column="1"
                          Classes="edit-btn"
                          Classes.editing="{Binding IsEditing}"
                          Command="{Binding ToggleEditCommand}"
                          VerticalAlignment="Center"
                          Margin="2 0 2 0"
                          ToolTip.Tip="Переименовать">
                    <TextBlock Text="✎" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                  </Button>

                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <!-- Разделитель -->
      <Border Grid.Row="3" Classes="divider"/>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 3 — Настройки (10%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="4">
        <Button Classes="settings"
                Classes.active="{Binding IsModelsActive}"
                Command="{Binding ShowSettingsCommand}"
                IsEnabled="{Binding IsAdmin}"
                ToolTip.Tip="{Binding SettingsToolTip}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="&#9881;"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource ThemeAccentBrush}"/>
            <TextBlock Text="Настройки"
                       FontSize="14"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

    </Grid>
  </Border>

</UserControl>

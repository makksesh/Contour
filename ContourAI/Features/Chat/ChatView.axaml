<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Chat"
             xmlns:markdown="using:ContourAI.Widgets.Markdown"
             x:Class="ContourAI.Features.Chat.ChatView"
             x:DataType="vm:ChatViewModel">

  <UserControl.Styles>
    <!-- ── TextBox ─────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
      <Setter Property="Background"   Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="BorderBrush"  Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding"      Value="12 8"/>
      <Setter Property="FontSize"     Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MaxHeight" Value="220"/>
    </Style>
    <Style Selector="TextBox.chat-input:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>

    <Style Selector="SelectableTextBlock.message-text">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="SelectionBrush" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="SelectionForegroundBrush" Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Ibeam"/>
    </Style>

    <Style Selector="SelectableTextBlock.user-message">
      <Setter Property="Foreground" Value="{StaticResource ThemeTextOnLightBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="SelectableTextBlock.assistant-message">
      <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>

    <Style Selector="Border.rag-badge">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="999"/>
      <Setter Property="Padding" Value="10 4"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="TextBlock.rag-badge-text">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0"
            Background="Transparent"
            BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="0 0 0 1"
            Padding="20 12">
      <TextBlock Text="{Binding SelectedThreadTitle}"
                 FontSize="15"
                 FontWeight="Medium"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    </Border>

    <ScrollViewer Grid.Row="1"
                  x:Name="MessagesScroll"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="20 16">

        <StackPanel IsVisible="{Binding !HasActiveThread}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="&#x1F4AC;" FontSize="36"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Выберите чат в боковой панели"
                     FontSize="14"
                     Classes="muted"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsMessagesEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="Начните диалог"
                     FontSize="14"
                     Classes="secondary"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Задайте вопрос — ассистент ответит с учётом текущего контекста"
                     FontSize="12"
                     Classes="muted"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock IsVisible="{Binding IsLoadingMessages}"
                   Text="Загрузка сообщений..."
                   Classes="muted"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <ItemsControl ItemsSource="{Binding Messages}"
                      IsVisible="{Binding !IsLoadingMessages}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ChatMessageViewModel">
              <Grid Margin="0 4">

                <Border IsVisible="{Binding IsUser}"
                        Background="{StaticResource ThemeSandBrush}"
                        BorderBrush="{StaticResource ThemeBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10 10 2 10"
                        Padding="12 8"
                        MaxWidth="560"
                        HorizontalAlignment="Right">
                  <SelectableTextBlock Text="{Binding Content}"
                                       Classes="message-text user-message"/>
                </Border>

                <Border IsVisible="{Binding IsAssistant}"
                        Background="{StaticResource ThemeSurfaceBrush}"
                        CornerRadius="10 10 10 2"
                        BorderBrush="{StaticResource ThemeBorderBrush}"
                        BorderThickness="1"
                        Padding="12 8"
                        MaxWidth="680"
                        HorizontalAlignment="Left">
                  <StackPanel Spacing="4">
                    <TextBlock Text="Ассистент"
                               FontSize="11"
                               Foreground="{StaticResource ThemeAccentBrush}"
                               FontWeight="SemiBold"/>

                    <SelectableTextBlock Text="{Binding Content}"
                                         Classes="message-text assistant-message"
                                         MaxWidth="640"
                                         IsVisible="{Binding IsStreaming}"/>

                    <markdown:MarkdownView Markdown="{Binding Content}"
                                           MaxWidth="640"
                                           IsVisible="{Binding !IsStreaming}"/>

                    <TextBlock IsVisible="{Binding IsStreaming}"
                               Text="●●●"
                               Foreground="{StaticResource ThemeAccentBrush}"
                               FontSize="12"
                               Margin="4 0 0 0"
                               Opacity="0.7"/>
                  </StackPanel>
                </Border>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="Transparent"
            BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="0 1 0 0"
            Padding="16 12">
      <StackPanel Spacing="8">

        <Border Classes="rag-badge"
                IsVisible="{Binding RagBadgeVisible}">
          <TextBlock Classes="rag-badge-text"
                     Text="{Binding RagBadgeText}"/>
        </Border>

        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0"
                   Classes="chat-input"
                   Text="{Binding InputText}"
                   PlaceholderText="Напишите ассистенту..."
                   AcceptsReturn="True"
                   KeyDown="Input_KeyDown"/>

          <Button Grid.Column="1"
                  Classes="ghost"
                  Margin="8 0 0 0"
                  IsVisible="{Binding IsSending}"
                  Command="{Binding CancelSendCommand}">
            ✕
          </Button>

          <Button Grid.Column="2"
                  Classes="primary"
                  Margin="8 0 0 0"
                  Command="{Binding SendCommand}"
                  IsEnabled="{Binding !IsSending}">
            Отправить
          </Button>
        </Grid>
      </StackPanel>
    </Border>

  </Grid>
</UserControl>

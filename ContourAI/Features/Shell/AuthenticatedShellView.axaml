<!--
  Авторизованный shell-экран.
  ContentControl переключает между Projects, Chat и Documents через CurrentContent.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="using:ContourAI.Widgets.Shell"
             xmlns:vm="clr-namespace:ContourAI.Features.Shell"
             x:DataType="vm:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Features.Shell.AuthenticatedShellView">
  <Grid ColumnDefinitions="280,*"
        Background="{StaticResource ThemeWindowBrush}">
    <shell:SidebarView DataContext="{Binding}"
                       Margin="16" />

    <Grid Grid.Column="1"
          Margin="0 16 16 16"
          RowDefinitions="Auto,*">
      <shell:TopbarView DataContext="{Binding}" />
      <Border Grid.Row="1"
              Classes="panel"
              Margin="0 16 0 0"
              Padding="28 24"
              CornerRadius="24"
              Background="{StaticResource ThemeShellBrush}">
        <ContentControl Content="{Binding CurrentContent}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>

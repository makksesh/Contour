<!--
  WorkspaceSyncView — вкладка Sync рабочего пространства.
  Состояния:
    IsNotAttached → форма Attach (пути + кнопка)
    IsAttached    → статус + кнопки Snapshot / Refresh / Agent Tasks
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Workspace"
             x:Class="ContourAI.Features.Workspace.WorkspaceSyncView"
             x:DataType="vm:WorkspaceSyncViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" MaxWidth="560" Margin="0 4 0 0">

      <!-- ── Ошибка ─────────────────────────────────────────────────────── -->
      <Border IsVisible="{Binding HasError}"
              Background="{StaticResource ThemeDangerSoftBrush}"
              BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="1"
              CornerRadius="6" Padding="10 7">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ThemeDangerTextBrush}"
                   FontSize="12" TextWrapping="Wrap"/>
      </Border>

      <!-- ── Статус ─────────────────────────────────────────────────────── -->
      <Border IsVisible="{Binding StatusMessage, Converter={x:Static vm:WorkspaceSyncViewHelpers.IsNonEmpty}}"
              Background="{StaticResource ThemeAccentSoftBrush}"
              CornerRadius="6" Padding="10 7">
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{StaticResource ThemeTextSecondaryBrush}"
                   FontSize="11"/>
      </Border>

      <!-- ════════════════════════════════════════════════════════════════════
           НЕ ПОДКЛЮЧЁН — форма Attach
      ════════════════════════════════════════════════════════════════════ -->
      <StackPanel IsVisible="{Binding IsNotAttached}" Spacing="14">

        <TextBlock Text="Подключение рабочего пространства к серверу"
                   FontSize="13" FontWeight="SemiBold"
                   Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
        <TextBlock Text="Свяжите локальную папку проекта с серверным зеркальным путём, чтобы AI-агент мог читать и изменять файлы."
                   FontSize="11" Foreground="{StaticResource ThemeTextMutedBrush}"
                   TextWrapping="Wrap"/>

        <!-- Local root path -->
        <StackPanel Spacing="3">
          <TextBlock Text="Локальный путь к корню"
                     FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}" Margin="0 0 0 3"/>
          <TextBox Text="{Binding LocalRootPath}"
                   PlaceholderText="/Users/me/projects/my-app"
                   Background="{StaticResource ThemeSurfaceAltBrush}"
                   Foreground="{StaticResource ThemeTextPrimaryBrush}"
                   BorderBrush="{StaticResource ThemeBorderBrush}"
                   CornerRadius="5" Padding="8 5" FontSize="12"/>
        </StackPanel>

        <!-- Server mirror path -->
        <StackPanel Spacing="3">
          <TextBlock Text="Зеркальный путь на сервере"
                     FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}" Margin="0 0 0 3"/>
          <TextBox Text="{Binding ServerMirrorPath}"
                   PlaceholderText="/srv/devassistant/mirrors/my-app"
                   Background="{StaticResource ThemeSurfaceAltBrush}"
                   Foreground="{StaticResource ThemeTextPrimaryBrush}"
                   BorderBrush="{StaticResource ThemeBorderBrush}"
                   CornerRadius="5" Padding="8 5" FontSize="12"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Classes="primary"
                  Command="{Binding AttachCommand}"
                  IsEnabled="{Binding !IsLoading}">
            Подключить
          </Button>
          <TextBlock IsVisible="{Binding IsLoading}"
                     Text="Подключение…"
                     FontSize="12" Foreground="{StaticResource ThemeTextMutedBrush}"
                     VerticalAlignment="Center"/>
        </StackPanel>

      </StackPanel>

      <!-- ════════════════════════════════════════════════════════════════════
           ПОДКЛЮЧЁН — статус + действия
      ════════════════════════════════════════════════════════════════════ -->
      <StackPanel IsVisible="{Binding IsAttached}" Spacing="14">

        <!-- Workspace info card -->
        <Border Background="{StaticResource ThemeSurfaceAltBrush}"
                BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14 12">
          <StackPanel Spacing="8">

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="Локальный корень"
                         FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}"
                         Width="110" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding LocalRootPath}"
                         FontSize="12" Foreground="{StaticResource ThemeTextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>

            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Grid.Column="0" Text="Зеркало на сервере"
                         FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}"
                         Width="110" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding ServerMirrorPath}"
                         FontSize="12" Foreground="{StaticResource ThemeTextSecondaryBrush}"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>

          </StackPanel>
        </Border>

        <!-- Кнопки действий -->
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">

          <Button Classes="primary"
                  Command="{Binding SnapshotCommand}"
                  IsEnabled="{Binding !IsSyncing}">
            ↑ Отправить снимок
          </Button>

          <Button Classes="ghost"
                  Command="{Binding RefreshStatusCommand}"
                  IsEnabled="{Binding !IsLoading}">
            ↺ Обновить
          </Button>

          <Button Classes="ghost"
                  Command="{Binding OpenAgentTasksCommand}">
            🤖 Задачи агента
          </Button>

        </StackPanel>

        <TextBlock IsVisible="{Binding IsSyncing}"
                   Text="Сканирование файлов и отправка снимка на сервер…"
                   FontSize="11" Foreground="{StaticResource ThemeTextMutedBrush}"
                   TextWrapping="Wrap"/>

      </StackPanel>

    </StackPanel>
  </ScrollViewer>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:ContourAI.Features.Auth"
             x:DataType="auth:LoginViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Features.Auth.LoginView">
  <Border Background="{StaticResource ThemeWindowBrush}"
          Padding="32">
    <Grid RowDefinitions="Auto,*"
          MaxWidth="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <StackPanel Spacing="8"
                  Margin="0,0,0,24">
        <TextBlock Text="ContourAI"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ThemeTextPrimaryBrush}" />
        <TextBlock Text="Настольное рабочее пространство для локальных AI-сценариев"
                   FontSize="12"
                   FontWeight="Medium"
                   Classes="secondary" />
        <TextBlock Text="Вход в ContourAI"
                   FontSize="15"
                   Classes="secondary" />
      </StackPanel>

      <Border Grid.Row="1"
              Classes="card"
              Background="{StaticResource ThemeSandBrush}"
              CornerRadius="18"
              Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="IP сервера"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Например: 192.168.3.50"
                     Text="{Binding ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
            <TextBlock Text="Указывается только IP или имя хоста, без порта. Настройка сохраняется в памяти приложения."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Classes="on-light-secondary" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Email или имя пользователя"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Введите email или имя пользователя"
                     Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Пароль"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Введите пароль"
                     PasswordChar="●"
                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <TextBlock Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource ThemeDangerBrush}"
                     IsVisible="{Binding HasError}" />

          <Button Classes="primary"
                  Content="Войти"
                  Height="44"
                  Command="{Binding LoginCommand}"
                  FontWeight="SemiBold" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="Нет аккаунта?"
                       Classes="on-light-secondary" />
            <Button Content="Зарегистрироваться"
                    Command="{Binding OpenRegisterCommand}"
                    Classes="link" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

<!--
  Авторизованный shell-экран.
  ContentControl переключает между Dashboard и Projects через CurrentContent.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="using:ContourAI.Widgets.Shell"
             xmlns:vm="clr-namespace:ContourAI.Features.Shell"
             x:DataType="vm:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Features.Shell.AuthenticatedShellView">
  <Grid ColumnDefinitions="280,*"
        Background="#020617">
    <shell:SidebarView DataContext="{Binding}" />

    <Grid Grid.Column="1"
          RowDefinitions="Auto,*">
      <shell:TopbarView DataContext="{Binding}" />
      <Border Grid.Row="1"
              Padding="24"
              Background="#030712">
        <ContentControl Content="{Binding CurrentContent}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>

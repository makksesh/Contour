<!--
  ChatView — чат с ИИ (single-pane):
    • Хедер: название активного треда
    • Лента сообщений с Markdown-рендерингом
    • Поле ввода + SSE-стриминг (CancelSendCommand)
  Список тредов вынесен в SidebarView — здесь он не нужен.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Chat"
             xmlns:markdown="using:ContourAI.Widgets.Markdown"
             x:Class="ContourAI.Features.Chat.ChatView"
             x:DataType="vm:ChatViewModel">

  <UserControl.Styles>
    <!-- ── TextBox ─────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
      <Setter Property="Background"   Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="BorderBrush"  Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding"      Value="12 8"/>
      <Setter Property="FontSize"     Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="MaxHeight" Value="220"/>
    </Style>
    <Style Selector="TextBox.chat-input:focus /template/ Border">
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>

    <Style Selector="SelectableTextBlock.message-text">
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="SelectionBrush" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="SelectionForegroundBrush" Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="Cursor" Value="Ibeam"/>
    </Style>

    <Style Selector="SelectableTextBlock.user-message">
      <Setter Property="Foreground" Value="{StaticResource ThemeTextOnLightBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style Selector="SelectableTextBlock.assistant-message">
      <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="LineHeight" Value="21"/>
    </Style>
  </UserControl.Styles>

  <!--
    Grid: 3 строки — хедер / лента сообщений / поле ввода.
    Список тредов и переключатель Global/Project убраны:
    навигация по тредам находится в SidebarView.
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ─── Хедер: название активного треда ─────────────────────── -->
    <Border Grid.Row="0"
            Background="Transparent"
            BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="0 0 0 1"
            Padding="20 12">
      <TextBlock Text="{Binding SelectedThreadTitle}"
                 FontSize="15"
                 FontWeight="Medium"
                 Foreground="{StaticResource ThemeTextSecondaryBrush}"/>
    </Border>

    <!-- ─── Лента сообщений ───────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1"
                  x:Name="MessagesScroll"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="20 16">

        <!-- Нет активного треда — выбор через Sidebar -->
        <StackPanel IsVisible="{Binding !HasActiveThread}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="&#x1F4AC;" FontSize="36"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Выберите чат в боковой панели"
                     FontSize="14"
                     Classes="muted"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Пустой тред -->
        <StackPanel IsVisible="{Binding IsMessagesEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="Начните диалог"
                     FontSize="14"
                     Classes="secondary"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Задайте вопрос — ассистент ответит с учётом текущего контекста"
                     FontSize="12"
                     Classes="muted"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Загрузка сообщений -->
        <TextBlock IsVisible="{Binding IsLoadingMessages}"
                   Text="Загрузка сообщений..."
                   Classes="muted"
                   FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Список сообщений -->
        <ItemsControl ItemsSource="{Binding Messages}"
                      IsVisible="{Binding !IsLoadingMessages}">
          <ItemsControl.ItemTemplate>
            <!--
              DataType = ChatMessageViewModel:
                Role: MessageRole.User | Assistant
                Content: string (обновляется токен за токеном при SSE)
                IsStreaming: bool
                IsUser / IsAssistant: bool
            -->
            <DataTemplate DataType="vm:ChatMessageViewModel">
              <Grid Margin="0 4">

                <!-- Сообщение пользователя — справа -->
                <Border IsVisible="{Binding IsUser}"
                        Background="{StaticResource ThemeSandBrush}"
                        BorderBrush="{StaticResource ThemeBorderSoftBrush}"
                        BorderThickness="1"
                        CornerRadius="10 10 2 10"
                        Padding="12 8"
                        MaxWidth="560"
                        HorizontalAlignment="Right">
                  <SelectableTextBlock Text="{Binding Content}"
                                       Classes="message-text user-message"/>
                </Border>

                <!-- Ответ ассистента — слева -->
                <Border IsVisible="{Binding IsAssistant}"
                        Background="{StaticResource ThemeSurfaceBrush}"
                        CornerRadius="10 10 10 2"
                        BorderBrush="{StaticResource ThemeBorderBrush}"
                        BorderThickness="1"
                        Padding="12 8"
                        MaxWidth="680"
                        HorizontalAlignment="Left">
                  <StackPanel Spacing="4">

                    <!-- Лейбл роли -->
                    <TextBlock Text="Ассистент"
                               FontSize="11"
                               Foreground="{StaticResource ThemeAccentBrush}"
                               FontWeight="SemiBold"/>

                    <SelectableTextBlock Text="{Binding Content}"
                                         Classes="message-text assistant-message"
                                         MaxWidth="640"
                                         IsVisible="{Binding IsStreaming}"/>

                    <markdown:MarkdownView Markdown="{Binding Content}"
                                           MaxWidth="640"
                                           IsVisible="{Binding !IsStreaming}"/>

                    <!-- Индикатор стриминга -->
                    <TextBlock IsVisible="{Binding IsStreaming}"
                               Text="●●●"
                               Foreground="{StaticResource ThemeAccentBrush}"
                               FontSize="12"
                               Margin="4 0 0 0"
                               Opacity="0.7"/>

                  </StackPanel>
                </Border>

              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>
    </ScrollViewer>

    <!-- ─── Панель ввода ──────────────────────────────────────────── -->
    <Border Grid.Row="2"
            Background="Transparent"
            BorderBrush="{StaticResource ThemeBorderBrush}"
            BorderThickness="0 1 0 0"
            Padding="16 12">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <TextBox Grid.Column="0"
                 Classes="chat-input"
                 Text="{Binding InputText}"
                 PlaceholderText="Напишите ассистенту..."
                 AcceptsReturn="True"
                 KeyDown="Input_KeyDown"/>

        <!-- Кнопка отмены SSE -->
        <Button Grid.Column="1"
                Classes="ghost"
                Margin="8 0 0 0"
                IsVisible="{Binding IsSending}"
                Command="{Binding CancelSendCommand}">
          ✕
        </Button>

        <!-- Кнопка отправки -->
        <Button Grid.Column="2"
                Classes="primary"
                Margin="8 0 0 0"
                Command="{Binding SendCommand}"
                IsEnabled="{Binding !IsSending}">
          Отправить
        </Button>

      </Grid>
    </Border>

  </Grid>
</UserControl>

<!--
  Sidebar с навигационными кнопками и подсветкой активной секции.
  Фаза 4: Projects подключён к ShowProjectsCommand.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ContourAI.Features.Shell"
             x:DataType="shell:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Widgets.Shell.SidebarView">
  <Border Background="#0F172A"
          Padding="20">
    <DockPanel LastChildFill="True">
      <StackPanel DockPanel.Dock="Top"
                  Spacing="6">

        <!-- Логотип -->
        <StackPanel Spacing="6"
                    Margin="0,0,0,24">
          <TextBlock Text="ContourAI"
                     FontSize="22"
                     FontWeight="SemiBold"
                     Foreground="#F9FAFB" />
          <TextBlock Text="AI workspace"
                     FontSize="12"
                     Foreground="#94A3B8" />
        </StackPanel>

        <!-- Dashboard -->
        <Button Content="Dashboard"
                Command="{Binding ShowDashboardCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="{Binding IsDashboardActive, Converter={x:Static BoolConverters.False}, ConverterParameter=Transparent}"
                Foreground="{Binding IsDashboardActive, Converter={x:Static BoolConverters.False}, ConverterParameter=#CBD5E1}">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#CBD5E1" />
            </Style>
          </Button.Styles>
        </Button>

        <!-- Projects -->
        <Button Content="Projects"
                Command="{Binding ShowProjectsCommand}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#CBD5E1">
          <Button.Styles>
            <Style Selector="Button">
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="Foreground" Value="#CBD5E1" />
            </Style>
          </Button.Styles>
        </Button>

        <!-- Остальные — будут активированы в следующих фазах -->
        <Button Content="Global Chat"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#475569"
                IsEnabled="False" />
        <Button Content="Documents"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#475569"
                IsEnabled="False" />
        <Button Content="Indexing"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#475569"
                IsEnabled="False" />
        <Button Content="RAG Search"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#475569"
                IsEnabled="False" />
        <Button Content="System Monitor"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Height="42"
                Padding="12,0"
                CornerRadius="6"
                Background="Transparent"
                Foreground="#475569"
                IsEnabled="False" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Bottom"
                  Spacing="8"
                  Margin="0,20,0,0">
        <TextBlock Text="Server"
                   FontSize="12"
                   Foreground="#94A3B8" />
        <TextBlock Text="{Binding ServerIpDisplay}"
                   FontSize="13"
                   Foreground="#5EEAD4" />
      </StackPanel>
    </DockPanel>
  </Border>
</UserControl>

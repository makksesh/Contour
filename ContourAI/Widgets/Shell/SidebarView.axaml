<!--
  SidebarView — переработанный боковой бар.
  Разделён на 3 части: 45% недавние глобальные чаты | 45% недавние проекты | 10% кнопка Настройки.
  Логотип и информация о сервере убраны.
  Скролл внутри каждой секции если элементы не помещаются.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ContourAI.Features.Shell"
             xmlns:chat="clr-namespace:ContourAI.Features.Chat"
             xmlns:projects="clr-namespace:ContourAI.Features.Projects"
             x:DataType="shell:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Widgets.Shell.SidebarView">

  <UserControl.Styles>

    <!-- Заголовок секции -->
    <Style Selector="TextBlock.section-header">
      <Setter Property="FontSize"      Value="11"/>
      <Setter Property="FontWeight"    Value="SemiBold"/>
      <Setter Property="Foreground"    Value="#475569"/>
      <Setter Property="Margin"        Value="12 0 12 6"/>
      <Setter Property="LetterSpacing" Value="1"/>
    </Style>

    <!-- Строка элемента (чат / проект) -->
    <Style Selector="Button.item">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="#CBD5E1"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Padding"                    Value="12 7"/>
      <Setter Property="CornerRadius"               Value="6"/>
      <Setter Property="Margin"                     Value="6 1"/>
      <Setter Property="Height"                     Value="46"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.item:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
    </Style>
    <Style Selector="Button.item.active">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="Foreground" Value="#5EEAD4"/>
    </Style>

    <!-- Кнопка Настройки -->
    <Style Selector="Button.settings">
      <Setter Property="Background"                 Value="Transparent"/>
      <Setter Property="Foreground"                 Value="#94A3B8"/>
      <Setter Property="HorizontalAlignment"        Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Height"                     Value="44"/>
      <Setter Property="Padding"                    Value="14 0"/>
      <Setter Property="CornerRadius"               Value="6"/>
      <Setter Property="Margin"                     Value="6 4"/>
      <Setter Property="Cursor"                     Value="Hand"/>
    </Style>
    <Style Selector="Button.settings:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
    </Style>

    <!-- Divider -->
    <Style Selector="Border.divider">
      <Setter Property="Height"          Value="1"/>
      <Setter Property="Background"      Value="#1E293B"/>
      <Setter Property="Margin"          Value="0"/>
    </Style>

  </UserControl.Styles>

  <!-- Основной контейнер -->
  <Border Background="#0F172A">
    <Grid>
      <!-- 3 строки: 45* | 45* | 10* -->
      <Grid.RowDefinitions>
        <RowDefinition Height="45*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="45*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="10*"/>
      </Grid.RowDefinitions>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 1 — Недавние глобальные чаты (45%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="0" RowDefinitions="Auto,*">

        <!-- Заголовок секции чатов -->
        <TextBlock Grid.Row="0"
                   Classes="section-header"
                   Text="RECENT CHATS"
                   Margin="12 14 12 6"/>

        <!-- Скроллируемый список чатов -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentGlobalChats}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="chat:ChatThreadItemViewModel">
                <!--
                  Кнопка треда: название + время последнего использования.
                  Команда открытия треда передаётся через привязку к Shell ViewModel
                  через RelativeSource + Tag (Id) — или используется SelectChatCommand.
                -->
                <Button Classes="item"
                        Classes.active="{Binding IsSelected}"
                        Command="{Binding $parent[UserControl].((shell:AuthenticatedShellViewModel)DataContext).SelectGlobalChatCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Название чата -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Title}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{Binding $parent[Button].Foreground}"/>
                    <!-- Время -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding TimeLabel}"
                               FontSize="11"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               Margin="6 0 0 0"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <!-- Разделитель -->
      <Border Grid.Row="1" Classes="divider"/>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 2 — Недавние проекты (45%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">

        <!-- Заголовок секции проектов -->
        <TextBlock Grid.Row="0"
                   Classes="section-header"
                   Text="RECENT PROJECTS"
                   Margin="12 12 12 6"/>

        <!-- Скроллируемый список проектов -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding RecentProjects}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="projects:ProjectCardViewModel">
                <!--
                  Кнопка проекта: название + дата создания.
                -->
                <Button Classes="item"
                        Command="{Binding $parent[UserControl].((shell:AuthenticatedShellViewModel)DataContext).OpenProjectFromSidebarCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Название проекта -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Name}"
                               FontSize="13"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               Foreground="{Binding $parent[Button].Foreground}"/>
                    <!-- Дата -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding CreatedAtLabel}"
                               FontSize="11"
                               Foreground="#475569"
                               VerticalAlignment="Center"
                               Margin="6 0 0 0"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <!-- Разделитель -->
      <Border Grid.Row="3" Classes="divider"/>

      <!-- ═══════════════════════════════════════════════
           СЕКЦИЯ 3 — Настройки (10%)
           ═══════════════════════════════════════════════ -->
      <Grid Grid.Row="4" RowDefinitions="*">
        <!--
          Кнопка «Настройки» — фон прозрачный, при наведении меняется.
          Иконка шестерёнки (Unicode) + подпись.
        -->
        <Button Classes="settings"
                Command="{Binding ShowSettingsCommand}"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <!-- Иконка шестерёнки -->
            <TextBlock Text="&#9881;"
                       FontSize="16"
                       VerticalAlignment="Center"
                       Foreground="#64748B"/>
            <TextBlock Text="Settings"
                       FontSize="14"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

    </Grid>
  </Border>

</UserControl>

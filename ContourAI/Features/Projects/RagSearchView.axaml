<!--
  RagSearchView — вкладка «RAG Search» в ProjectWorkspaceView.
  Отображает поисковую строку, TopK и список RagChunkItemViewModel.
  DataContext: RagSearchViewModel.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Projects"
             x:Class="ContourAI.Features.Projects.RagSearchView"
             x:DataType="vm:RagSearchViewModel">

  <UserControl.Styles>

    <Style Selector="TextBox.rag-input">
      <Setter Property="Background"   Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="BorderBrush"  Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding"      Value="10 7"/>
      <Setter Property="FontSize"     Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!--
      chunk-text: ReadOnly TextBox для выделения текста чанка.
      IsReadOnly=True сохраняет навигацию курсором и выделение,
      но запрещает редактирование.
    -->
    <Style Selector="TextBox.chunk-text">
      <Setter Property="IsReadOnly"    Value="True"/>
      <Setter Property="Background"    Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"       Value="0"/>
      <Setter Property="Margin"        Value="0 5 0 0"/>
      <Setter Property="FontSize"      Value="12"/>
      <Setter Property="Foreground"    Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="TextWrapping"  Value="Wrap"/>
      <Setter Property="AcceptsReturn" Value="False"/>
      <Setter Property="CaretBrush"    Value="Transparent"/>
      <!-- Убираем рамку при фокусе — выглядит как обычный текст -->
      <Setter Property="FocusAdorner"  Value="{x:Null}"/>
    </Style>
    <Style Selector="TextBox.chunk-text:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background"  Value="Transparent"/>
    </Style>
    <Style Selector="TextBox.chunk-text:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background"  Value="Transparent"/>
    </Style>

    <Style Selector="TextBlock.chunk-location">
      <Setter Property="FontSize"     Value="10"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style Selector="TextBlock.chunk-score">
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeAccentMutedBrush}"/>
    </Style>
    <Style Selector="Button.expand-btn">
      <Setter Property="Background"      Value="Transparent"/>
      <Setter Property="Foreground"      Value="{StaticResource ThemeAccentBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"         Value="0 2"/>
      <Setter Property="FontSize"        Value="11"/>
      <Setter Property="Cursor"          Value="Hand"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <!-- ─── Панель поиска ─────────────────────────────────────────── -->
    <StackPanel Grid.Row="0" Spacing="8" Margin="0 0 0 14">

      <!--
        DockPanel: кнопка «Top-K» и «Найти» привязаны право,
        TextBox занимает всё оставшееся пространство.
        LastChildFill=True — дефолт DockPanel, но указываем явно.
      -->
      <DockPanel LastChildFill="True">

        <NumericUpDown DockPanel.Dock="Right"
                       Value="{Binding TopK}"
                       Minimum="1" Maximum="20" Increment="1" FormatString="0"
                       Width="90"
                       ToolTip.Tip="Количество чанков (Top-K)"
                       Background="{StaticResource ThemeSurfaceAltBrush}"
                       Foreground="{StaticResource ThemeTextPrimaryBrush}"
                       BorderBrush="{StaticResource ThemeBorderBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Margin="8 0 0 0"/>

        <Button DockPanel.Dock="Right"
                Classes="primary"
                Command="{Binding SearchCommand}"
                IsEnabled="{Binding !IsLoading}"
                VerticalAlignment="Center"
                Margin="8 0 0 0">Найти</Button>

        <TextBox Classes="rag-input"
                 Text="{Binding Query}"
                 PlaceholderText="Введите поисковый запрос по документам проекта…">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Return" Command="{Binding SearchCommand}"/>
          </TextBox.KeyBindings>
        </TextBox>

      </DockPanel>

      <!-- Ошибка -->
      <Border IsVisible="{Binding HasError}"
              Background="{StaticResource ThemeDangerSoftBrush}"
              BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="1"
              CornerRadius="6" Padding="10 7">
        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ThemeDangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
      </Border>

    </StackPanel>

    <!-- ─── Результаты ──────────────────────────────────────────────── -->
    <Panel Grid.Row="1">

      <!-- Загрузка -->
      <StackPanel IsVisible="{Binding IsLoading}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="Поиск…"
                   FontSize="13" Foreground="{StaticResource ThemeTextMutedBrush}"
                   HorizontalAlignment="Center"/>
      </StackPanel>

      <!-- Пустое состояние -->
      <StackPanel IsVisible="{Binding IsEmpty}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="🔍" FontSize="32" HorizontalAlignment="Center"/>
        <TextBlock Text="Введите запрос для поиска по документам"
                   FontSize="13" Foreground="{StaticResource ThemeTextSecondaryBrush}"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="Будут найдены наиболее релевантные фрагменты из прикреплённых файлов"
                   FontSize="11" Foreground="{StaticResource ThemeTextMutedBrush}"
                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"/>
      </StackPanel>

      <!-- Список чанков -->
      <ScrollViewer IsVisible="{Binding !IsEmpty}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Results}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RagChunkItemViewModel">
              <Border Background="{StaticResource ThemeSandBrush}"
                      CornerRadius="10" Padding="12 10" Margin="0 0 0 8">
                <StackPanel Spacing="0">

                  <!-- Шапка: локация + оценка -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="chunk-location"
                               Text="{Binding LocationLabel}"/>
                    <TextBlock Grid.Column="1"
                               Classes="chunk-score"
                               Text="{Binding ScoreLabel}"
                               Margin="8 0 0 0"/>
                  </Grid>

                  <!--
                    Текст чанка — ReadOnly TextBox вместо TextBlock.
                    Позволяет выделять и копировать текст,
                    но запрещает редактирование.
                  -->
                  <TextBox Classes="chunk-text"
                           Text="{Binding DisplayContent}"/>

                  <!-- Кнопка «Развернуть / Свернуть» -->
                  <Button Classes="expand-btn"
                          IsVisible="{Binding HasMore}"
                          Command="{Binding ToggleExpandCommand}"
                          Content="{Binding ExpandButtonLabel}"
                          Margin="0 4 0 0"/>

                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

    </Panel>
  </Grid>

</UserControl>

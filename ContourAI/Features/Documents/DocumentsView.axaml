<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Documents"
             x:Class="ContourAI.Features.Documents.DocumentsView"
             x:DataType="vm:DocumentsViewModel">

  <UserControl.Styles>
    <Style Selector="Button.filter">
      <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="Padding" Value="10 5"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style Selector="Button.filter.active">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentMutedBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- ═══ MAIN LAYOUT ═══ -->
    <Grid RowDefinitions="Auto,Auto,*" Margin="32 24">

      <!-- Header -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0 0 0 16">
        <StackPanel Grid.Column="0" Spacing="3">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Документы" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextPrimaryBrush}"/>
            <Border Classes="card" Background="{StaticResource ThemeSandAltBrush}" CornerRadius="8" Padding="10 3" VerticalAlignment="Center">
              <TextBlock Text="{Binding ProjectName}" FontSize="12" Classes="on-light" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <TextBlock Text="Загружайте документы проекта и управляйте ими" FontSize="13" Classes="secondary"/>
        </StackPanel>
        <!-- Upload: handled via Click in code-behind to pass TopLevel -->
        <Button x:Name="UploadButton"
                Grid.Column="1" Classes="primary"
                IsEnabled="{Binding !IsUploading}">
          <Panel>
            <TextBlock Text="↑ Загрузить файл" IsVisible="{Binding !IsUploading}"/>
            <TextBlock Text="Загрузка..."   IsVisible="{Binding IsUploading}"/>
          </Panel>
        </Button>
      </Grid>

      <!-- Filter bar: each button calls SetFilterCommand with its index -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0 0 0 16">
        <Button Classes="filter"
                Classes.active="{Binding IsFilterAll}"
                Command="{Binding SetFilterCommand}" CommandParameter="0">Все</Button>
        <Button Classes="filter"
                Classes.active="{Binding IsFilterIndexed}"
                Command="{Binding SetFilterCommand}" CommandParameter="1">Индексированы</Button>
        <Button Classes="filter"
                Classes.active="{Binding IsFilterPending}"
                Command="{Binding SetFilterCommand}" CommandParameter="2">Ожидают</Button>
        <Button Classes="filter"
                Classes.active="{Binding IsFilterProcessing}"
                Command="{Binding SetFilterCommand}" CommandParameter="3">Обрабатываются</Button>
        <Button Classes="filter"
                Classes.active="{Binding IsFilterFailed}"
                Command="{Binding SetFilterCommand}" CommandParameter="4">С ошибкой</Button>
        <Button Classes="ghost" Command="{Binding LoadCommand}" FontSize="12">↻ Обновить</Button>
      </StackPanel>

      <!-- Content area -->
      <Grid Grid.Row="2">
        <!-- Loading -->
        <TextBlock IsVisible="{Binding IsLoading}"
                   Text="Загрузка документов..."
                   Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- Error -->
        <StackPanel IsVisible="{Binding HasError}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
          <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ThemeDangerBrush}" HorizontalAlignment="Center"/>
          <Button Classes="primary" Command="{Binding LoadCommand}" HorizontalAlignment="Center">Повторить</Button>
        </StackPanel>

        <!-- Empty -->
        <StackPanel IsVisible="{Binding IsEmpty}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
          <TextBlock Text="Документов пока нет" FontSize="16" FontWeight="Medium"
                     Foreground="{StaticResource ThemeTextPrimaryBrush}" HorizontalAlignment="Center"/>
          <TextBlock Text="Загрузите файлы, чтобы подготовить их для RAG-поиска"
                     FontSize="13" Classes="secondary" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Document list -->
        <ScrollViewer IsVisible="{Binding !IsLoading}">
          <ItemsControl ItemsSource="{Binding Documents}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="vm:DocumentCardViewModel">
                <Border Classes="card"
                        Margin="0 0 0 8"
                        Background="{StaticResource ThemeSandBrush}"
                        CornerRadius="12"
                        Padding="16 12">
                  <Grid ColumnDefinitions="*,Auto">
                    <!-- Info -->
                    <StackPanel Grid.Column="0" Spacing="4">
                      <TextBlock Text="{Binding FileName}" FontSize="14" FontWeight="Medium"
                                 Classes="on-light"
                                 TextTrimming="CharacterEllipsis"/>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding SizeLabel}"  FontSize="12" Classes="on-light-secondary"/>
                        <TextBlock Text="•" FontSize="12" Foreground="{StaticResource ThemeBorderSoftBrush}"/>
                        <TextBlock Text="{Binding ContentType}" FontSize="12" Classes="on-light-secondary"/>
                        <TextBlock Text="•" FontSize="12" Foreground="{StaticResource ThemeBorderSoftBrush}"/>
                        <TextBlock Text="{Binding StatusLabel}" FontSize="12"
                                   Foreground="{Binding StatusColor}"/>
                      </StackPanel>
                      <TextBlock IsVisible="{Binding HasError}"
                                 Text="{Binding ErrorMessage}"
                                 FontSize="11" Foreground="{StaticResource ThemeDangerBrush}"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Actions -->
                    <Button Grid.Column="1" Classes="danger" FontSize="12"
                            Command="{Binding DeleteCommand}" VerticalAlignment="Center">
                      ✕
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- ═══ DELETE CONFIRM OVERLAY ═══ -->
    <Grid IsVisible="{Binding IsDeleteConfirmOpen}">
      <Border Background="{StaticResource ThemeOverlayBrush}"/>
      <Border Width="360"
              Classes="card"
              Background="{StaticResource ThemeSandBrush}"
              CornerRadius="16"
              HorizontalAlignment="Center" VerticalAlignment="Center"
              Padding="28 24">
        <StackPanel Spacing="16">
          <TextBlock Text="Удалить документ" FontSize="18" FontWeight="SemiBold" Classes="on-light"/>
          <TextBlock TextWrapping="Wrap" Classes="on-light-secondary" FontSize="13">
            <Run Text="Вы уверены, что хотите удалить документ "/>
            <Run Text="{Binding DeleteConfirmName}" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextOnLightBrush}"/>
            <Run Text="? Это действие нельзя отменить."/>
          </TextBlock>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Classes="ghost"  Command="{Binding CancelDeleteCommand}">Отмена</Button>
            <Button Classes="danger" Command="{Binding ConfirmDeleteCommand}">Удалить</Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:ContourAI.Features.Auth"
             x:DataType="auth:RegisterViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Features.Auth.RegisterView">
  <Border Background="{StaticResource ThemeWindowBrush}"
          Padding="32">
    <Grid RowDefinitions="Auto,*"
          MaxWidth="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <StackPanel Spacing="8"
                  Margin="0,0,0,24">
        <TextBlock Text="Создание аккаунта"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource ThemeTextPrimaryBrush}" />
        <TextBlock Text="Регистрация в системе ContourAI"
                   FontSize="15"
                   Classes="secondary" />
      </StackPanel>

      <Border Grid.Row="1"
              Classes="card"
              Background="{StaticResource ThemeSandBrush}"
              CornerRadius="18"
              Padding="24">
        <StackPanel Spacing="16">
          <Border Classes="panel-alt"
                  Background="{StaticResource ThemeSandAltBrush}"
                  CornerRadius="12"
                  Padding="12">
            <StackPanel Spacing="4">
              <TextBlock Text="Текущий сервер"
                         FontWeight="SemiBold"
                         Classes="on-light" />
              <TextBlock Text="{Binding ServerIpDisplay}"
                         Classes="on-light-secondary"
                         FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Text="Имя пользователя"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Введите имя пользователя"
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Электронная почта"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Введите электронную почту"
                     Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Пароль"
                       FontWeight="SemiBold"
                       Classes="on-light" />
            <TextBox PlaceholderText="Введите пароль"
                     PasswordChar="●"
                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <TextBlock Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource ThemeDangerBrush}"
                     IsVisible="{Binding HasError}" />

          <Button Classes="primary"
                  Content="Создать аккаунт"
                  Height="44"
                  Command="{Binding RegisterCommand}"
                  FontWeight="SemiBold" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="Уже есть аккаунт?"
                       Classes="on-light-secondary" />
            <Button Content="Войти"
                    Command="{Binding OpenLoginCommand}"
                    Classes="link" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

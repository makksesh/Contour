<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shell="clr-namespace:ContourAI.Features.Shell"
             xmlns:metrics="using:ContourAI.Widgets.SystemMetrics"
             x:DataType="shell:AuthenticatedShellViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Widgets.Shell.TopbarView">
  <Border Classes="panel"
          Background="{StaticResource ThemeShellBrush}"
          CornerRadius="24"
          Padding="24,18">
    <Grid ColumnDefinitions="*,Auto"
          VerticalAlignment="Center">
      <metrics:SystemMetricsView DataContext="{Binding Metrics}" />

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="12"
                  VerticalAlignment="Center">
        <Border Classes="card"
                Background="{StaticResource ThemeSandAltBrush}"
                CornerRadius="14"
                Padding="14,8">
          <TextBlock Text="{Binding ServerIpDisplay}"
                     Classes="on-light"
                     FontWeight="SemiBold" />
        </Border>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>

<!--
  ProjectWorkspaceView — workspace проекта.
  Вкладки: Settings, Folder, Documents, Chat, Sync.
  Sync: WorkspaceSyncView / AgentTasksView / ChangeSetReviewView (внутренная навигация).
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Projects"
             xmlns:chat="clr-namespace:ContourAI.Features.Chat"
             xmlns:ws="clr-namespace:ContourAI.Features.Workspace"
             x:Class="ContourAI.Features.Projects.ProjectWorkspaceView"
             x:DataType="vm:ProjectWorkspaceViewModel">

  <UserControl.Styles>

    <Style Selector="Button.back-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"     Value="6 4"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.back-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>

    <Style Selector="Button.tab-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="FontWeight"  Value="Medium"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.tab-btn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeAccentBrush}"/>
    </Style>

    <Style Selector="Button.icon-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding"     Value="4 3"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize"    Value="11"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.icon-btn.del:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource ThemeDangerSoftBrush}"/>
      <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeDangerTextBrush}"/>
    </Style>

    <Style Selector="TextBox.settings-input">
      <Setter Property="Background"   Value="{StaticResource ThemeSurfaceAltBrush}"/>
      <Setter Property="Foreground"   Value="{StaticResource ThemeTextPrimaryBrush}"/>
      <Setter Property="BorderBrush"  Value="{StaticResource ThemeBorderBrush}"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding"      Value="8 5"/>
      <Setter Property="FontSize"     Value="12"/>
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="Foreground" Value="{StaticResource ThemeTextMutedBrush}"/>
      <Setter Property="Margin"     Value="0 0 0 3"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ═══ HEADER ═══ -->
    <Border Grid.Row="0"
            BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0 0 0 1"
            Padding="12 0">
      <StackPanel Orientation="Horizontal" Spacing="4" Height="40">

        <Button Classes="back-btn" Command="{Binding GoBackCommand}">← Назад</Button>
        <Border Width="1" Background="{StaticResource ThemeBorderBrush}" Margin="4 8"/>
        <TextBlock Text="{Binding ProjectName}"
                   FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeTextSecondaryBrush}"
                   VerticalAlignment="Center" Margin="4 0"/>
        <Border Width="1" Background="{StaticResource ThemeBorderBrush}" Margin="4 8"/>

        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Settings}">Настройки</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Folder}">Папка</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Documents}">Документы</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsChat}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Chat}">Чат</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSync}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Sync}">Синхронизация</Button>

        <TextBlock IsVisible="{Binding IsLoading}"
                   Text="…" Foreground="{StaticResource ThemeTextMutedBrush}" FontSize="12"
                   VerticalAlignment="Center" Margin="8 0 0 0"/>
      </StackPanel>
    </Border>

    <!-- ═══ КОНТЕНТ ВКЛАДОК ═══ -->
    <Border Grid.Row="1" Background="Transparent" Padding="20 14">
      <Panel>

        <!-- ── SETTINGS TAB ───────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580"
                      DataContext="{Binding SettingsViewModel}">

            <Border IsVisible="{Binding HasError}"
                    Background="{StaticResource ThemeDangerSoftBrush}" BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ThemeDangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Системный промпт"/>
              <TextBox Classes="settings-input" Text="{Binding SystemPrompt}"
                       AcceptsReturn="True" Height="90" TextWrapping="Wrap" PlaceholderText="Введите системный промпт…"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Макс. токены  (1–32768)"/>
              <NumericUpDown Value="{Binding MaxTokens}" Minimum="1" Maximum="32768" Increment="256" FormatString="0"
                             Background="{StaticResource ThemeSurfaceAltBrush}" Foreground="{StaticResource ThemeTextPrimaryBrush}" BorderBrush="{StaticResource ThemeBorderBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Температура  (0.0–2.0)"/>
              <NumericUpDown Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.00"
                             Background="{StaticResource ThemeSurfaceAltBrush}" Foreground="{StaticResource ThemeTextPrimaryBrush}" BorderBrush="{StaticResource ThemeBorderBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="RAG Top-K  (1–20)"/>
              <NumericUpDown Value="{Binding RagTopK}" Minimum="1" Maximum="20" Increment="1" FormatString="0"
                             Background="{StaticResource ThemeSurfaceAltBrush}" Foreground="{StaticResource ThemeTextPrimaryBrush}" BorderBrush="{StaticResource ThemeBorderBrush}" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Окно контекста  (1–50)"/>
              <NumericUpDown Value="{Binding ContextWindowSize}" Minimum="1" Maximum="50" Increment="1" FormatString="0"
                             Background="{StaticResource ThemeSurfaceAltBrush}" Foreground="{StaticResource ThemeTextPrimaryBrush}" BorderBrush="{StaticResource ThemeBorderBrush}" FontSize="12"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding UseRagContext}" Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12" Content="Использовать RAG-контекст"/>
            <Button Classes="primary" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding !IsBusy}">Сохранить настройки</Button>

            <!-- Danger Zone -->
            <Border BorderBrush="{StaticResource ThemeBorderBrush}" BorderThickness="0 1 0 0" Margin="0 10 0 0" Padding="0 14 0 0">
              <StackPanel Spacing="10">
                <TextBlock Text="Опасная зона" FontSize="10" Foreground="{StaticResource ThemeTextMutedBrush}" FontWeight="SemiBold"/>
                <Button Classes="danger" IsVisible="{Binding !IsDeleteConfirmVisible}"
                        Command="{Binding RequestDeleteProjectCommand}" IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Left">Удалить проект</Button>
                <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                        Background="{StaticResource ThemeDangerSoftBrush}" BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="1"
                        CornerRadius="6" Padding="14 12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Удалить этот проект?" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource ThemeDangerTextBrush}"/>
                    <TextBlock Text="Это действие нельзя отменить. Все настройки и связи с папками будут удалены безвозвратно."
                               FontSize="11" Foreground="{StaticResource ThemeTextSecondaryBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="danger" Command="{Binding ConfirmDeleteProjectCommand}" IsEnabled="{Binding !IsBusy}">Да, удалить</Button>
                      <Button Classes="ghost"  Command="{Binding CancelDeleteProjectCommand}"  IsEnabled="{Binding !IsBusy}">Отмена</Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ── FOLDER TAB ──────────────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580" DataContext="{Binding SettingsViewModel}">

            <Border IsVisible="{Binding HasError}" Background="{StaticResource ThemeDangerSoftBrush}" BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="1" CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ThemeDangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <StackPanel IsVisible="{Binding !HasFolderAttached}" Spacing="14">
              <TextBlock Text="Папка не подключена." Foreground="{StaticResource ThemeTextMutedBrush}" FontSize="12"/>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Путь к папке"/>
                <TextBox Classes="settings-input" Text="{Binding FolderPath}" PlaceholderText="/абсолютный/путь/к/папке"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Разрешения"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Чтение"   Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Изменение"   Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Удаление" Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <Button Classes="primary" Command="{Binding AttachFolderCommand}">Подключить папку</Button>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasFolderAttached}" Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Подключённый путь"/>
                <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Разрешения"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Чтение"   Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Изменение"   Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Удаление" Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SaveFolderPermissionsCommand}">Сохранить разрешения</Button>
                <Button Classes="danger"  Command="{Binding DetachFolderCommand}">Отключить</Button>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ── DOCUMENTS TAB ──────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
              RowDefinitions="Auto,*,Auto">

          <!-- Топ-бар: кнопки Upload + Refresh -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0 0 0 12">
            <Button Classes="primary"
                    Command="{Binding DocumentsViewModel.UploadCommand}"
                    IsEnabled="{Binding !DocumentsViewModel.IsUploading}">
              Загрузить файл
            </Button>
            <Button Classes="ghost"
                    Command="{Binding DocumentsViewModel.RefreshCommand}"
                    IsEnabled="{Binding !DocumentsViewModel.IsLoading}">
              ↺ Обновить
            </Button>
            <TextBlock IsVisible="{Binding DocumentsViewModel.IsUploading}"
                       Text="Загрузка…" Foreground="{StaticResource ThemeAccentBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="4 0"/>
            <TextBlock IsVisible="{Binding IsLoading}"
                       Text="Загрузка…" Foreground="{StaticResource ThemeTextMutedBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="4 0"/>
          </StackPanel>

          <!-- Список / empty state -->
          <Panel Grid.Row="1">

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding DocumentsViewModel.IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="Документов пока нет."
                         Foreground="{StaticResource ThemeTextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
              <TextBlock Text="Загрузите файл, чтобы начать работу."
                         Foreground="{StaticResource ThemeTextMutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Список документов -->
            <ScrollViewer IsVisible="{Binding !DocumentsViewModel.IsEmpty}"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DocumentsViewModel.Documents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DocumentItemViewModel">
                    <Border Classes="card"
                            Background="{StaticResource ThemeSandBrush}"
                            CornerRadius="10" Padding="12 9" Margin="0 0 0 6">
                      <Grid ColumnDefinitions="*,Auto">

                        <!-- Левая часть: название + мета -->
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="{Binding FileName}"
                                     FontSize="12" Foreground="{StaticResource ThemeTextOnLightBrush}"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="400"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SizeDisplay}"
                                       FontSize="10" Foreground="{StaticResource ThemeTextOnLightSecondaryBrush}"/>
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="10" Foreground="{StaticResource ThemeAccentMutedBrush}"/>
                            <TextBlock IsVisible="{Binding TaskError, Converter={x:Static vm:WorkspaceTabConverter.IsNotNull}}"
                                       Text="{Binding TaskError}"
                                       FontSize="10" Foreground="{StaticResource ThemeDangerBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                          </StackPanel>
                        </StackPanel>

                        <!-- Правая часть: кнопки -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">

                          <!-- Requeue (только если Failed) -->
                          <Button Classes="icon-btn"
                                  IsVisible="{Binding TaskStatus, Converter={x:Static vm:WorkspaceTabConverter.IsTaskFailed}}"
                                  Command="{Binding $parent[ItemsControl].((vm:ProjectDocumentsViewModel)DataContext).RequeueCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Повторить индексацию">
                            ↻
                          </Button>

                          <!-- Delete -->
                          <Button Classes="icon-btn del"
                                  Command="{Binding $parent[ItemsControl].((vm:ProjectDocumentsViewModel)DataContext).DeleteCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsDeleting}"
                                  ToolTip.Tip="Удалить документ">
                            ✕
                          </Button>

                        </StackPanel>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

          </Panel>

          <!-- Ошибка низу -->
          <Border Grid.Row="2"
                  IsVisible="{Binding HasError}"
                  Background="{StaticResource ThemeDangerSoftBrush}" BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="0 1 0 0"
                  Padding="12 8" Margin="0 8 0 0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ThemeDangerTextBrush}" FontSize="12" TextWrapping="Wrap"/>
          </Border>

        </Grid>

        <!-- ── CHAT TAB ─────────────────────────────────────────────────────── -->
        <Panel IsVisible="{Binding SelectedTabIndex,
                          Converter={x:Static vm:WorkspaceTabConverter.IsChat}}">

            <!--
              Состояние загрузки тредов.
              IsChatLoading=true → крутилка,
              IsChatLoading=false + ShowStartChatButton=true  → кнопка "Начать чат",
              IsChatLoading=false + ShowChatView=true         → ChatView.
            -->

            <!-- Загрузка -->
            <StackPanel IsVisible="{Binding IsChatLoading}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="Загрузка чата…"
                           FontSize="13" Foreground="{StaticResource ThemeTextMutedBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Нет чата — кнопка "Начать чат" -->
            <StackPanel IsVisible="{Binding ShowStartChatButton}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <TextBlock Text="&#x1F4AC;"
                           FontSize="40"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Чат ещё не создан"
                           FontSize="14" FontWeight="Medium"
                           Foreground="{StaticResource ThemeTextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Начните диалог с AI-ассистентом в контексте этого проекта."
                           FontSize="12" Foreground="{StaticResource ThemeTextMutedBrush}"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="340"
                           TextAlignment="Center"/>
                <Button Classes="primary"
                        HorizontalAlignment="Center"
                        Command="{Binding StartChatCommand}">
                    Начать чат
                </Button>
            </StackPanel>

            <!--
              Чат загружен — рендерим ChatView.
              DataContext переключается на ProjectChatViewModel.
              IsVisible привязан к ShowChatView чтобы Panel не занимал место
              пока VM ещё null.
            -->
            <Panel IsVisible="{Binding ShowChatView}">
              <chat:ChatView DataContext="{Binding ProjectChatViewModel}"/>
            </Panel>

        </Panel>

        <!-- ── SYNC TAB ───────────────────────────────────────────────────── -->
        <!--
          Внутренная навигация внутри вкладки Sync:
            SyncSubPanelIndex = 0 → WorkspaceSyncView
            SyncSubPanelIndex = 1 → AgentTasksView
            SyncSubPanelIndex = 2 → ChangeSetReviewView
        -->
        <Panel IsVisible="{Binding SelectedTabIndex,
                           Converter={x:Static vm:WorkspaceTabConverter.IsSync}}">

          <!-- 0: WorkspaceSyncView -->
          <ws:WorkspaceSyncView
            DataContext="{Binding SyncViewModel}"
            IsVisible="{Binding $parent[UserControl].((vm:ProjectWorkspaceViewModel)DataContext).SyncSubPanelIndex,
                        Converter={x:Static ws:SyncSubPanelConverter.IsSync}}"/>

          <!-- 1: AgentTasksView -->
          <ws:AgentTasksView
            DataContext="{Binding AgentTasksViewModel}"
            IsVisible="{Binding $parent[UserControl].((vm:ProjectWorkspaceViewModel)DataContext).SyncSubPanelIndex,
                        Converter={x:Static ws:SyncSubPanelConverter.IsAgentTasks}}"/>

          <!-- 2: ChangeSetReviewView -->
          <ws:ChangeSetReviewView
            DataContext="{Binding ReviewViewModel}"
            IsVisible="{Binding $parent[UserControl].((vm:ProjectWorkspaceViewModel)DataContext).SyncSubPanelIndex,
                        Converter={x:Static ws:SyncSubPanelConverter.IsReview}}"/>

        </Panel>

      </Panel>
    </Border>

    <!-- ═══ FOOTER: баннер ошибки загрузки рабочего пространства ═══ -->
    <Border Grid.Row="2"
            IsVisible="{Binding HasError}"
            Background="{StaticResource ThemeDangerSoftBrush}" BorderBrush="{StaticResource ThemeDangerBrush}" BorderThickness="0 1 0 0"
            Padding="16 10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ThemeDangerTextBrush}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Classes="primary"
                Command="{Binding LoadSettingsCommand}"
                Margin="12 0 0 0">Повторить</Button>
      </Grid>
    </Border>

  </Grid>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:auth="clr-namespace:ContourAI.Features.Auth"
             x:DataType="auth:LoginViewModel"
             mc:Ignorable="d"
             x:Class="ContourAI.Features.Auth.LoginView">
  <Border Background="#111827"
          Padding="32">
    <Grid RowDefinitions="Auto,*"
          MaxWidth="520"
          HorizontalAlignment="Center"
          VerticalAlignment="Center">
      <StackPanel Spacing="8"
                  Margin="0,0,0,24">
        <TextBlock Text="ContourAI"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="#F9FAFB" />
        <TextBlock Text="Вход в DevAssistant UI"
                   FontSize="15"
                   Foreground="#9CA3AF" />
      </StackPanel>

      <Border Grid.Row="1"
              Background="#1F2937"
              CornerRadius="18"
              Padding="24">
        <StackPanel Spacing="16">
          <StackPanel Spacing="6">
            <TextBlock Text="IP сервера"
                       FontWeight="SemiBold"
                       Foreground="#F3F4F6" />
            <TextBox Watermark="Например: 192.168.3.50"
                     Text="{Binding ServerIp, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
            <TextBlock Text="Указывается только IP или host, без порта. Настройка сохраняется в памяти приложения."
                       TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="#9CA3AF" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Email или username"
                       FontWeight="SemiBold"
                       Foreground="#F3F4F6" />
            <TextBox Watermark="Введите email или username"
                     Text="{Binding Identifier, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="Пароль"
                       FontWeight="SemiBold"
                       Foreground="#F3F4F6" />
            <TextBox Watermark="Введите пароль"
                     PasswordChar="●"
                     Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Classes="auth-input" />
          </StackPanel>

          <TextBlock Text="{Binding ErrorMessage}"
                     TextWrapping="Wrap"
                     Foreground="#FCA5A5"
                     IsVisible="{Binding HasError}" />

          <Button Content="Войти"
                  Height="44"
                  Command="{Binding LoginCommand}"
                  Background="#0F766E"
                  Foreground="White"
                  FontWeight="SemiBold" />

          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      HorizontalAlignment="Center">
            <TextBlock Text="Нет аккаунта?"
                       Foreground="#9CA3AF" />
            <Button Content="Зарегистрироваться"
                    Command="{Binding OpenRegisterCommand}"
                    Background="Transparent"
                    Foreground="#5EEAD4" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</UserControl>

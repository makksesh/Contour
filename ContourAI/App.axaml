<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ContourAI.App"
             xmlns:local="using:ContourAI"
             RequestedThemeVariant="Dark">
             <!-- The application uses a fixed dark theme with warm elevated surfaces. -->

    <Application.Resources>
        <LinearGradientBrush x:Key="ThemeWindowBrush"
                             StartPoint="0,0"
                             EndPoint="1,1">
            <GradientStop Color="#151618" Offset="0"/>
            <GradientStop Color="#1C1A18" Offset="0.52"/>
            <GradientStop Color="#111214" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ThemeBackgroundBrush" Color="#151618"/>
        <SolidColorBrush x:Key="ThemeShellBrush" Color="#181A1D"/>
        <SolidColorBrush x:Key="ThemeSurfaceBrush" Color="#1D1F22"/>
        <SolidColorBrush x:Key="ThemeSurfaceAltBrush" Color="#26292D"/>
        <SolidColorBrush x:Key="ThemeBorderBrush" Color="#3A3D42"/>
        <SolidColorBrush x:Key="ThemeBorderSoftBrush" Color="#4B4540"/>
        <SolidColorBrush x:Key="ThemeTextPrimaryBrush" Color="#F3EBDD"/>
        <SolidColorBrush x:Key="ThemeTextSecondaryBrush" Color="#C9BEAE"/>
        <SolidColorBrush x:Key="ThemeTextMutedBrush" Color="#968B7E"/>
        <SolidColorBrush x:Key="ThemeTextOnLightBrush" Color="#241F1A"/>
        <SolidColorBrush x:Key="ThemeTextOnLightSecondaryBrush" Color="#5E554B"/>
        <SolidColorBrush x:Key="ThemeSandBrush" Color="#D8CCBC"/>
        <SolidColorBrush x:Key="ThemeSandAltBrush" Color="#CFC1B1"/>
        <SolidColorBrush x:Key="ThemeAccentBrush" Color="#B7926A"/>
        <SolidColorBrush x:Key="ThemeAccentMutedBrush" Color="#8E6C4B"/>
        <SolidColorBrush x:Key="ThemeAccentSoftBrush" Color="#33B7926A"/>
        <SolidColorBrush x:Key="ThemeHighlightBrush" Color="#1AF3EBDD"/>
        <SolidColorBrush x:Key="ThemeOverlayBrush" Color="#AA111214"/>
        <SolidColorBrush x:Key="ThemeDangerBrush" Color="#8C4E49"/>
        <SolidColorBrush x:Key="ThemeDangerSoftBrush" Color="#3A2624"/>
        <SolidColorBrush x:Key="ThemeDangerTextBrush" Color="#F0C8C1"/>
        <SolidColorBrush x:Key="ThemeSuccessBrush" Color="#8D9E73"/>
        <SolidColorBrush x:Key="ThemeSuccessTextBrush" Color="#DCE8CF"/>
        <SolidColorBrush x:Key="ThemeWarningBrush" Color="#B88A56"/>
        <SolidColorBrush x:Key="ThemeWarningTextBrush" Color="#F6DEC0"/>
    </Application.Resources>

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource ThemeWindowBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextMutedBrush}"/>
        </Style>

        <Style Selector="TextBlock.secondary">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.on-light">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextOnLightBrush}"/>
        </Style>

        <Style Selector="TextBlock.on-light-secondary">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextOnLightSecondaryBrush}"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource ThemeSandBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderSoftBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>

        <Style Selector="Border.panel-alt">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14 8"/>
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
        </Style>

        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceBrush}"/>
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#202224"/>
            <Setter Property="TextBlock.Foreground" Value="#7B7166"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource ThemeAccentBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextOnLightBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#CAA57D"/>
        </Style>

        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ThemeAccentMutedBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
        </Style>

        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ThemeAccentSoftBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{StaticResource ThemeDangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeDangerTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeDangerBrush}"/>
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource ThemeDangerBrush}"/>
            <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
        </Style>

        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeAccentBrush}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style Selector="Button.link:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextBlock.Foreground" Value="#D5B189"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12 8"/>
            <Setter Property="CaretBrush" Value="{StaticResource ThemeAccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource ThemeAccentSoftBrush}"/>
        </Style>

        <Style Selector="TextBox:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
        </Style>

        <Style Selector="TextBox.inline-edit">
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="2 1"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="NumericUpDown:focus /template/ Border">
            <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentBrush}"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource ThemeTextSecondaryBrush}"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource ThemeSurfaceAltBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource ThemeTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderBrush}"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>
    </Application.Styles>
</Application>

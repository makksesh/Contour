<!--
  ProjectWorkspaceView — workspace проекта.
  Вкладки: Settings, Folder, Documents, Chat.
  Documents: список документов + Upload + Delete + Requeue + Refresh.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Projects"
             x:Class="ContourAI.Features.Projects.ProjectWorkspaceView"
             x:DataType="vm:ProjectWorkspaceViewModel">

  <UserControl.Styles>

    <Style Selector="Button.back-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#64748B"/>
      <Setter Property="Padding"     Value="6 4"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.back-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>

    <Style Selector="Button.tab-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#64748B"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="6 6 0 0"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="FontWeight"  Value="Medium"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.tab-btn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="TextBlock.Foreground" Value="#5EEAD4"/>
    </Style>

    <Style Selector="Button.primary">
      <Setter Property="Background"  Value="#01696f"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="Padding"     Value="14 6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0c4e54"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1c3537"/>
      <Setter Property="TextBlock.Foreground" Value="#4a7a7e"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background"  Value="#7f1d4b"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#9d1f5e"/>
    </Style>
    <Style Selector="Button.danger:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#3d1226"/>
      <Setter Property="TextBlock.Foreground" Value="#7a3d5a"/>
    </Style>

    <Style Selector="Button.ghost">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#64748B"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="BorderBrush" Value="#2d2c2a"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>

    <Style Selector="Button.icon-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#475569"/>
      <Setter Property="Padding"     Value="4 3"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontSize"    Value="11"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.icon-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.icon-btn.del:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3d1226"/>
      <Setter Property="TextBlock.Foreground" Value="#f87171"/>
    </Style>

    <Style Selector="TextBox.settings-input">
      <Setter Property="Background"   Value="#1c1b19"/>
      <Setter Property="Foreground"   Value="#cdccca"/>
      <Setter Property="BorderBrush"  Value="#2d2c2a"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding"      Value="8 5"/>
      <Setter Property="FontSize"     Value="12"/>
    </Style>

    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Margin"     Value="0 0 0 3"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ═══ HEADER ═══ -->
    <Border Grid.Row="0"
            BorderBrush="#1E293B" BorderThickness="0 0 0 1"
            Padding="12 0">
      <StackPanel Orientation="Horizontal" Spacing="4" Height="40">

        <Button Classes="back-btn" Command="{Binding GoBackCommand}">← Back</Button>
        <Border Width="1" Background="#1E293B" Margin="4 8"/>
        <TextBlock Text="{Binding ProjectName}"
                   FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1"
                   VerticalAlignment="Center" Margin="4 0"/>
        <Border Width="1" Background="#1E293B" Margin="4 8"/>

        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Settings}">Settings</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Folder}">Folder</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Documents}">Documents</Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsChat}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Chat}">Chat</Button>

        <TextBlock IsVisible="{Binding IsLoading}"
                   Text="…" Foreground="#475569" FontSize="12"
                   VerticalAlignment="Center" Margin="8 0 0 0"/>
      </StackPanel>
    </Border>

    <!-- ═══ КОНТЕНТ ВКЛАДОК ═══ -->
    <Border Grid.Row="1" Background="#0B1120" Padding="20 14">
      <Panel>

        <!-- ── SETTINGS TAB ───────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580"
                      DataContext="{Binding SettingsViewModel}">

            <Border IsVisible="{Binding HasError}"
                    Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="1"
                    CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#f87171" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="System Prompt"/>
              <TextBox Classes="settings-input" Text="{Binding SystemPrompt}"
                       AcceptsReturn="True" Height="90" TextWrapping="Wrap" Watermark="Enter system prompt…"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Max Tokens  (1–32768)"/>
              <NumericUpDown Value="{Binding MaxTokens}" Minimum="1" Maximum="32768" Increment="256" FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca" BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Temperature  (0.0–2.0)"/>
              <NumericUpDown Value="{Binding Temperature}" Minimum="0" Maximum="2" Increment="0.05" FormatString="0.00"
                             Background="#1c1b19" Foreground="#cdccca" BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="RAG Top-K  (1–20)"/>
              <NumericUpDown Value="{Binding RagTopK}" Minimum="1" Maximum="20" Increment="1" FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca" BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Context Window  (1–50)"/>
              <NumericUpDown Value="{Binding ContextWindowSize}" Minimum="1" Maximum="50" Increment="1" FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca" BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>
            <CheckBox IsChecked="{Binding UseRagContext}" Foreground="#94A3B8" FontSize="12" Content="Use RAG Context"/>
            <Button Classes="primary" Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding !IsBusy}">Save Settings</Button>

            <!-- Danger Zone -->
            <Border BorderBrush="#2d1520" BorderThickness="0 1 0 0" Margin="0 10 0 0" Padding="0 14 0 0">
              <StackPanel Spacing="10">
                <TextBlock Text="Danger Zone" FontSize="10" Foreground="#64748B" FontWeight="SemiBold"/>
                <Button Classes="danger" IsVisible="{Binding !IsDeleteConfirmVisible}"
                        Command="{Binding RequestDeleteProjectCommand}" IsEnabled="{Binding !IsBusy}"
                        HorizontalAlignment="Left">Delete Project</Button>
                <Border IsVisible="{Binding IsDeleteConfirmVisible}"
                        Background="#1a0810" BorderBrush="#5c1c2e" BorderThickness="1"
                        CornerRadius="6" Padding="14 12">
                  <StackPanel Spacing="10">
                    <TextBlock Text="Delete this project?" FontSize="13" FontWeight="SemiBold" Foreground="#f87171"/>
                    <TextBlock Text="This action cannot be undone. All settings and folder links will be permanently removed."
                               FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="danger" Command="{Binding ConfirmDeleteProjectCommand}" IsEnabled="{Binding !IsBusy}">Yes, delete</Button>
                      <Button Classes="ghost"  Command="{Binding CancelDeleteProjectCommand}"  IsEnabled="{Binding !IsBusy}">Cancel</Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

          </StackPanel>
        </ScrollViewer>

        <!-- ── FOLDER TAB ──────────────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580" DataContext="{Binding SettingsViewModel}">

            <Border IsVisible="{Binding HasError}" Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="1" CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}" Foreground="#f87171" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <StackPanel IsVisible="{Binding !HasFolderAttached}" Spacing="14">
              <TextBlock Text="No folder connected." Foreground="#475569" FontSize="12"/>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Folder Path"/>
                <TextBox Classes="settings-input" Text="{Binding FolderPath}" Watermark="/absolute/path/to/folder"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Permissions"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Read"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Edit"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Delete" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <Button Classes="primary" Command="{Binding AttachFolderCommand}">Connect Folder</Button>
            </StackPanel>

            <StackPanel IsVisible="{Binding HasFolderAttached}" Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Connected Path"/>
                <TextBlock Text="{Binding FolderPath}" Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Permissions"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Read"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Edit"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Delete" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SaveFolderPermissionsCommand}">Save Permissions</Button>
                <Button Classes="danger"  Command="{Binding DetachFolderCommand}">Disconnect</Button>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ── DOCUMENTS TAB ──────────────────────────────────────────────── -->
        <Grid IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
              RowDefinitions="Auto,*,Auto">

          <!-- Топ-бар: кнопки Upload + Refresh -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0 0 0 12">
            <Button Classes="primary"
                    Command="{Binding DocumentsViewModel.UploadCommand}"
                    IsEnabled="{Binding !DocumentsViewModel.IsUploading}">
              Upload File
            </Button>
            <Button Classes="ghost"
                    Command="{Binding DocumentsViewModel.RefreshCommand}"
                    IsEnabled="{Binding !DocumentsViewModel.IsLoading}">
              ↺ Refresh
            </Button>
            <TextBlock IsVisible="{Binding DocumentsViewModel.IsUploading}"
                       Text="Uploading…" Foreground="#4f98a3" FontSize="12"
                       VerticalAlignment="Center" Margin="4 0"/>
            <TextBlock IsVisible="{Binding IsLoading}"
                       Text="Loading…" Foreground="#475569" FontSize="12"
                       VerticalAlignment="Center" Margin="4 0"/>
          </StackPanel>

          <!-- Список / empty state -->
          <Panel Grid.Row="1">

            <!-- Empty state -->
            <StackPanel IsVisible="{Binding DocumentsViewModel.IsEmpty}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
              <TextBlock Text="No documents yet."
                         Foreground="#334155" FontSize="13" HorizontalAlignment="Center"/>
              <TextBlock Text="Upload a file to get started."
                         Foreground="#1e3a4a" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Список документов -->
            <ScrollViewer IsVisible="{Binding !DocumentsViewModel.IsEmpty}"
                          VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding DocumentsViewModel.Documents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:DocumentItemViewModel">
                    <Border Background="#111827"
                            BorderBrush="#1e293b" BorderThickness="1"
                            CornerRadius="7" Padding="12 9" Margin="0 0 0 6">
                      <Grid ColumnDefinitions="*,Auto">

                        <!-- Левая часть: название + мета -->
                        <StackPanel Grid.Column="0" Spacing="3">
                          <TextBlock Text="{Binding FileName}"
                                     FontSize="12" Foreground="#CBD5E1"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="400"/>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding SizeDisplay}"
                                       FontSize="10" Foreground="#475569"/>
                            <TextBlock Text="{Binding StatusLabel}"
                                       FontSize="10" Foreground="#4f98a3"/>
                            <TextBlock IsVisible="{Binding TaskError, Converter={x:Static vm:WorkspaceTabConverter.IsNotNull}}"
                                       Text="{Binding TaskError}"
                                       FontSize="10" Foreground="#f87171"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                          </StackPanel>
                        </StackPanel>

                        <!-- Правая часть: кнопки -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">

                          <!-- Requeue (только если Failed) -->
                          <Button Classes="icon-btn"
                                  IsVisible="{Binding TaskStatus, Converter={x:Static vm:WorkspaceTabConverter.IsTaskFailed}}"
                                  Command="{Binding $parent[ItemsControl].((vm:ProjectDocumentsViewModel)DataContext).RequeueCommand}"
                                  CommandParameter="{Binding}"
                                  ToolTip.Tip="Retry indexing">
                            ↻
                          </Button>

                          <!-- Delete -->
                          <Button Classes="icon-btn del"
                                  Command="{Binding $parent[ItemsControl].((vm:ProjectDocumentsViewModel)DataContext).DeleteCommand}"
                                  CommandParameter="{Binding}"
                                  IsEnabled="{Binding !IsDeleting}"
                                  ToolTip.Tip="Delete document">
                            ✕
                          </Button>

                        </StackPanel>

                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>

          </Panel>

          <!-- Ошибка низу -->
          <Border Grid.Row="2"
                  IsVisible="{Binding HasError}"
                  Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="0 1 0 0"
                  Padding="12 8" Margin="0 8 0 0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#f87171" FontSize="12" TextWrapping="Wrap"/>
          </Border>

        </Grid>

        <!-- ── CHAT TAB ───────────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsChat}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="Chat" FontSize="14" FontWeight="Medium"
                     Foreground="#CBD5E1" HorizontalAlignment="Center"/>
          <TextBlock Text="Coming soon." Foreground="#334155" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>

      </Panel>
    </Border>

    <!-- ═══ FOOTER: баннер ошибки загрузки рабочего пространства ═══ -->
    <Border Grid.Row="2"
            IsVisible="{Binding HasError}"
            Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="0 1 0 0"
            Padding="16 10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}"
                   Foreground="#f87171" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <Button Grid.Column="1" Classes="primary"
                Command="{Binding LoadSettingsCommand}"
                Margin="12 0 0 0">Retry</Button>
      </Grid>
    </Border>

  </Grid>

</UserControl>

<!--
  ProjectWorkspaceView — workspace проекта.
  Header: кнопка Back + название проекта + вкладки — всё в одну строку.
  Вкладки: Settings, Folder, Documents, Chat.
  Ошибка загрузки отображается в самом низу, под контентом вкладки.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Projects"
             x:Class="ContourAI.Features.Projects.ProjectWorkspaceView"
             x:DataType="vm:ProjectWorkspaceViewModel">

  <UserControl.Styles>

    <!-- Кнопка Back -->
    <Style Selector="Button.back-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#64748B"/>
      <Setter Property="Padding"     Value="6 4"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.back-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>

    <!-- Кнопка вкладки -->
    <Style Selector="Button.tab-btn">
      <Setter Property="Background"  Value="Transparent"/>
      <Setter Property="Foreground"  Value="#64748B"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="6 6 0 0"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="FontWeight"  Value="Medium"/>
      <Setter Property="Cursor"      Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
    <Style Selector="Button.tab-btn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1E293B"/>
      <Setter Property="TextBlock.Foreground" Value="#94A3B8"/>
    </Style>
    <Style Selector="Button.tab-btn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F172A"/>
      <Setter Property="TextBlock.Foreground" Value="#5EEAD4"/>
    </Style>

    <!-- Кнопка primary -->
    <Style Selector="Button.primary">
      <Setter Property="Background"  Value="#01696f"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="Padding"     Value="14 6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0c4e54"/>
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#1c3537"/>
      <Setter Property="TextBlock.Foreground" Value="#4a7a7e"/>
    </Style>

    <!-- Кнопка danger -->
    <Style Selector="Button.danger">
      <Setter Property="Background"  Value="#7f1d4b"/>
      <Setter Property="Foreground"  Value="White"/>
      <Setter Property="Padding"     Value="12 6"/>
      <Setter Property="CornerRadius" Value="6"/>
      <Setter Property="FontSize"    Value="12"/>
      <Setter Property="Cursor"      Value="Hand"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#9d1f5e"/>
    </Style>

    <!-- Поле ввода -->
    <Style Selector="TextBox.settings-input">
      <Setter Property="Background"   Value="#1c1b19"/>
      <Setter Property="Foreground"   Value="#cdccca"/>
      <Setter Property="BorderBrush"  Value="#2d2c2a"/>
      <Setter Property="CornerRadius" Value="5"/>
      <Setter Property="Padding"      Value="8 5"/>
      <Setter Property="FontSize"     Value="12"/>
    </Style>

    <!-- Метка поля -->
    <Style Selector="TextBlock.field-label">
      <Setter Property="FontSize"   Value="10"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Margin"     Value="0 0 0 3"/>
    </Style>

  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ═══ HEADER: Back | Название | │ Вкладки ═══ -->
    <Border Grid.Row="0"
            BorderBrush="#1E293B" BorderThickness="0 0 0 1"
            Padding="12 0">
      <StackPanel Orientation="Horizontal" Spacing="4" Height="40">

        <!-- Back -->
        <Button Classes="back-btn"
                Command="{Binding GoBackCommand}">
          ← Back
        </Button>

        <!-- Разделитель -->
        <Border Width="1" Background="#1E293B" Margin="4 8"/>

        <!-- Название проекта -->
        <TextBlock Text="{Binding ProjectName}"
                   FontSize="13" FontWeight="SemiBold" Foreground="#CBD5E1"
                   VerticalAlignment="Center" Margin="4 0"/>

        <!-- Разделитель -->
        <Border Width="1" Background="#1E293B" Margin="4 8"/>

        <!-- Вкладки -->
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Settings}">
          Settings
        </Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Folder}">
          Folder
        </Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Documents}">
          Documents
        </Button>
        <Button Classes="tab-btn"
                Classes.active="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsChat}}"
                Command="{Binding SelectTabCommand}"
                CommandParameter="{x:Static vm:WorkspaceTab.Chat}">
          Chat
        </Button>

        <!-- Индикатор загрузки -->
        <TextBlock IsVisible="{Binding IsLoading}"
                   Text="…" Foreground="#475569" FontSize="12"
                   VerticalAlignment="Center" Margin="8 0 0 0"/>

      </StackPanel>
    </Border>

    <!-- ═══ КОНТЕНТ ВКЛАДОК ═══ -->
    <Border Grid.Row="1" Background="#0B1120" Padding="20 14">
      <Panel>

        <!-- ── SETTINGS TAB ──────────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsSettings}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580"
                      DataContext="{Binding SettingsViewModel}">

            <!-- Ошибка сохранения (из SettingsViewModel) -->
            <Border IsVisible="{Binding HasError}"
                    Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="1"
                    CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="#f87171" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- System Prompt -->
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="System Prompt"/>
              <TextBox Classes="settings-input"
                       Text="{Binding SystemPrompt}"
                       AcceptsReturn="True" Height="90"
                       TextWrapping="Wrap"
                       Watermark="Enter system prompt…"/>
            </StackPanel>

            <!-- Max Tokens -->
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Max Tokens  (1–32768)"/>
              <NumericUpDown Value="{Binding MaxTokens}"
                             Minimum="1" Maximum="32768" Increment="256"
                             FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca"
                             BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>

            <!-- Temperature -->
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Temperature  (0.0–2.0)"/>
              <NumericUpDown Value="{Binding Temperature}"
                             Minimum="0" Maximum="2" Increment="0.05"
                             FormatString="0.00"
                             Background="#1c1b19" Foreground="#cdccca"
                             BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>

            <!-- RAG Top-K -->
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="RAG Top-K  (1–20)"/>
              <NumericUpDown Value="{Binding RagTopK}"
                             Minimum="1" Maximum="20" Increment="1"
                             FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca"
                             BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>

            <!-- Context Window -->
            <StackPanel Spacing="3">
              <TextBlock Classes="field-label" Text="Context Window  (1–50)"/>
              <NumericUpDown Value="{Binding ContextWindowSize}"
                             Minimum="1" Maximum="50" Increment="1"
                             FormatString="0"
                             Background="#1c1b19" Foreground="#cdccca"
                             BorderBrush="#2d2c2a" FontSize="12"/>
            </StackPanel>

            <!-- Use RAG -->
            <CheckBox IsChecked="{Binding UseRagContext}"
                      Foreground="#94A3B8" FontSize="12"
                      Content="Use RAG Context"/>

            <!-- Save -->
            <Button Classes="primary"
                    Command="{Binding SaveSettingsCommand}"
                    IsEnabled="{Binding !IsBusy}">
              Save Settings
            </Button>

          </StackPanel>
        </ScrollViewer>

        <!-- ── FOLDER TAB ──────────────────────────────────────────────────── -->
        <ScrollViewer IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsFolder}}"
                      VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="14" MaxWidth="580"
                      DataContext="{Binding SettingsViewModel}">

            <!-- Ошибка папки -->
            <Border IsVisible="{Binding HasError}"
                    Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="1"
                    CornerRadius="6" Padding="10 7">
              <TextBlock Text="{Binding ErrorMessage}"
                         Foreground="#f87171" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- Нет папки -->
            <StackPanel IsVisible="{Binding !HasFolderAttached}" Spacing="14">
              <TextBlock Text="No folder connected."
                         Foreground="#475569" FontSize="12"/>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Folder Path"/>
                <TextBox Classes="settings-input"
                         Text="{Binding FolderPath}"
                         Watermark="/absolute/path/to/folder"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Permissions"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Read"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Edit"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Delete" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <Button Classes="primary" Command="{Binding AttachFolderCommand}">
                Connect Folder
              </Button>
            </StackPanel>

            <!-- Папка подключена -->
            <StackPanel IsVisible="{Binding HasFolderAttached}" Spacing="14">
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Connected Path"/>
                <TextBlock Text="{Binding FolderPath}"
                           Foreground="#94A3B8" FontSize="12" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Spacing="3">
                <TextBlock Classes="field-label" Text="Permissions"/>
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox IsChecked="{Binding PermRead}"   Content="Read"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermEdit}"   Content="Edit"   Foreground="#94A3B8" FontSize="12"/>
                  <CheckBox IsChecked="{Binding PermDelete}" Content="Delete" Foreground="#94A3B8" FontSize="12"/>
                </StackPanel>
              </StackPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="primary" Command="{Binding SaveFolderPermissionsCommand}">
                  Save Permissions
                </Button>
                <Button Classes="danger" Command="{Binding DetachFolderCommand}">
                  Disconnect
                </Button>
              </StackPanel>
            </StackPanel>

          </StackPanel>
        </ScrollViewer>

        <!-- ── DOCUMENTS TAB ──────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsDocuments}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="Documents" FontSize="14" FontWeight="Medium"
                     Foreground="#CBD5E1" HorizontalAlignment="Center"/>
          <TextBlock Text="Coming soon."
                     Foreground="#334155" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- ── CHAT TAB ───────────────────────────────────────────────────── -->
        <StackPanel IsVisible="{Binding SelectedTabIndex, Converter={x:Static vm:WorkspaceTabConverter.IsChat}}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
          <TextBlock Text="Chat" FontSize="14" FontWeight="Medium"
                     Foreground="#CBD5E1" HorizontalAlignment="Center"/>
          <TextBlock Text="Coming soon."
                     Foreground="#334155" FontSize="12" HorizontalAlignment="Center"/>
        </StackPanel>

      </Panel>
    </Border>

    <!-- ═══ FOOTER: баннер ошибки загрузки (внизу, под всем контентом) ═══ -->
    <Border Grid.Row="2"
            IsVisible="{Binding HasError}"
            Background="#1a0a0d" BorderBrush="#5c1c2e" BorderThickness="0 1 0 0"
            Padding="16 10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="{Binding ErrorMessage}"
                   Foreground="#f87171" FontSize="12"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"/>
        <Button Grid.Column="1"
                Classes="primary"
                Command="{Binding LoadSettingsCommand}"
                Margin="12 0 0 0">
          Retry
        </Button>
      </Grid>
    </Border>

  </Grid>

</UserControl>

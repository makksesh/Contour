<!--
  ChatView — чат с ИИ (single-pane):
    • Хедер: название активного треда
    • Лента сообщений с Markdown-рендерингом
    • Поле ввода + SSE-стриминг (CancelSendCommand)
  Список тредов вынесен в SidebarView — здесь он не нужен.
  Проект: DevAssistant / ContourAI.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ContourAI.Features.Chat"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             x:Class="ContourAI.Features.Chat.ChatView"
             x:DataType="vm:ChatViewModel">

  <UserControl.Styles>
    <!-- ── Кнопки ─────────────────────────────────────────────────── -->
    <Style Selector="Button.primary">
      <Setter Property="Background"   Value="#01696f"/>
      <Setter Property="Foreground"   Value="White"/>
      <Setter Property="Padding"      Value="14 7"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0c4e54"/>
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background"   Value="Transparent"/>
      <Setter Property="Foreground"   Value="#7a7974"/>
      <Setter Property="Padding"      Value="10 5"/>
      <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22211f"/>
    </Style>

    <!-- ── TextBox ─────────────────────────────────────────────────── -->
    <Style Selector="TextBox.chat-input">
      <Setter Property="Background"   Value="#22211f"/>
      <Setter Property="Foreground"   Value="#cdccca"/>
      <Setter Property="BorderBrush"  Value="#393836"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding"      Value="12 8"/>
      <Setter Property="FontSize"     Value="14"/>
    </Style>
    <Style Selector="TextBox.chat-input:focus /template/ Border">
      <Setter Property="BorderBrush" Value="#4f98a3"/>
    </Style>
  </UserControl.Styles>

  <!--
    Grid: 3 строки — хедер / лента сообщений / поле ввода.
    Список тредов и переключатель Global/Project убраны:
    навигация по тредам находится в SidebarView.
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ─── Хедер: название активного треда ─────────────────────── -->
    <Border Grid.Row="0"
            Background="#1c1b19"
            BorderBrush="#262523"
            BorderThickness="0 0 0 1"
            Padding="20 12">
      <TextBlock Text="{Binding SelectedThreadTitle}"
                 FontSize="15"
                 FontWeight="Medium"
                 Foreground="#cdccca"/>
    </Border>

    <!-- ─── Лента сообщений ───────────────────────────────────────── -->
    <ScrollViewer Grid.Row="1"
                  x:Name="MessagesScroll"
                  VerticalScrollBarVisibility="Auto">
      <Grid Margin="20 16">

        <!-- Нет активного треда — выбор через Sidebar -->
        <StackPanel IsVisible="{Binding !HasActiveThread}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="&#x1F4AC;" FontSize="36"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Select a chat from the sidebar"
                     FontSize="14" Foreground="#5a5957"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Пустой тред -->
        <StackPanel IsVisible="{Binding IsMessagesEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">
          <TextBlock Text="Start the conversation"
                     FontSize="14" Foreground="#5a5957"
                     HorizontalAlignment="Center"/>
          <TextBlock Text="Ask anything — the assistant will answer based on context"
                     FontSize="12" Foreground="#393836"
                     HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Загрузка сообщений -->
        <TextBlock IsVisible="{Binding IsLoadingMessages}"
                   Text="Loading messages..."
                   Foreground="#5a5957" FontSize="13"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Список сообщений -->
        <ItemsControl ItemsSource="{Binding Messages}"
                      IsVisible="{Binding !IsLoadingMessages}">
          <ItemsControl.ItemTemplate>
            <!--
              DataType = ChatMessageViewModel:
                Role: MessageRole.User | Assistant
                Content: string (обновляется токен за токеном при SSE)
                IsStreaming: bool
                IsUser / IsAssistant: bool
            -->
            <DataTemplate DataType="vm:ChatMessageViewModel">
              <Grid Margin="0 4">

                <!-- Сообщение пользователя — справа -->
                <Border IsVisible="{Binding IsUser}"
                        Background="#313b3b"
                        CornerRadius="10 10 2 10"
                        Padding="12 8"
                        MaxWidth="560"
                        HorizontalAlignment="Right">
                  <TextBlock Text="{Binding Content}"
                             Foreground="#cdccca"
                             FontSize="14"
                             TextWrapping="Wrap"/>
                </Border>

                <!-- Ответ ассистента — слева (Markdown) -->
                <Border IsVisible="{Binding IsAssistant}"
                        Background="#1c1b19"
                        CornerRadius="10 10 10 2"
                        BorderBrush="#393836"
                        BorderThickness="1"
                        Padding="12 8"
                        MaxWidth="680"
                        HorizontalAlignment="Left">
                  <StackPanel Spacing="4">

                    <!-- Лейбл роли -->
                    <TextBlock Text="Assistant"
                               FontSize="11"
                               Foreground="#4f98a3"
                               FontWeight="SemiBold"/>

                    <!--
                      MarkdownScrollViewer (Markdown.Avalonia 12.0.0-a3):
                      скролл управляется внешним MessagesScroll.
                    -->
                    <md:MarkdownScrollViewer
                      Markdown="{Binding Content}"
                      MaxWidth="640"/>

                    <!-- Индикатор стриминга -->
                    <TextBlock IsVisible="{Binding IsStreaming}"
                               Text="●●●"
                               Foreground="#4f98a3"
                               FontSize="12"
                               Margin="4 0 0 0"
                               Opacity="0.7"/>

                  </StackPanel>
                </Border>

              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </Grid>
    </ScrollViewer>

    <!-- ─── Панель ввода ──────────────────────────────────────────── -->
    <Border Grid.Row="2"
            Background="#1c1b19"
            BorderBrush="#262523"
            BorderThickness="0 1 0 0"
            Padding="16 12">
      <Grid ColumnDefinitions="*,Auto,Auto">

        <TextBox Grid.Column="0"
                 Classes="chat-input"
                 Text="{Binding InputText}"
                 PlaceholderText="Message the assistant..."
                 AcceptsReturn="False"
                 KeyDown="Input_KeyDown"/>

        <!-- Кнопка отмены SSE -->
        <Button Grid.Column="1"
                Classes="ghost"
                Margin="8 0 0 0"
                IsVisible="{Binding IsSending}"
                Command="{Binding CancelSendCommand}">
          ✕
        </Button>

        <!-- Кнопка отправки -->
        <Button Grid.Column="2"
                Classes="primary"
                Margin="8 0 0 0"
                Command="{Binding SendCommand}"
                IsEnabled="{Binding !IsSending}">
          Send
        </Button>

      </Grid>
    </Border>

  </Grid>
</UserControl>
